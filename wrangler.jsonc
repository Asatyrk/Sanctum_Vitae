{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sanctum-vitae",
  "compatibility_date": "2026-06-01",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "."
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "routes": [
    {
      "pattern": "*.html",
      "custom_domain": true
    },
    {
      "pattern": "*.css",
      "custom_domain": true
    },
    {
      "pattern": "*.js",
      "custom_domain": true
    },
    {
      "pattern": "*.json",
      "custom_domain": true
    }
  ]
}
